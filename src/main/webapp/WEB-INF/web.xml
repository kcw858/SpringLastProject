<?xml version="1.0" encoding="UTF-8"?>
<web-app version="2.5" xmlns="http://java.sun.com/xml/ns/javaee"
	xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
	xsi:schemaLocation="http://java.sun.com/xml/ns/javaee https://java.sun.com/xml/ns/javaee/web-app_2_5.xsd">

	<!-- 
		톰캣 = 구동
			 Servlet
		
		사용자 요청 => DispatcherServlet 호출
							| 위임
					HandlerMapping
							| @Controller / @RestController
							|	=> GetMapping / PostMapping / RequestMapping
							|	=> RequestMapping은  GetMapping + PostMapping
						메소드 호출
							| 요청 처리 = 데이터연동 / Open API / 크롤링
							  화면에 출력할 데이터를 모아준다
							  request / session
							  ======= 클래스화 (전송객체 = Model)
					DispatcherServlet
							| JSP를 찾는다
						ViewResorver
							| JSP에 request / session에 담긴 데이터 전송
						   JSP
						   
		1. public class DispatcherServlet extends HttpServlet
		   {
		   		//가장 먼저 호출되는 메소드
			 	public void init(ServletConfg config)
			 	{
			 		XML 설정파일 읽기
			 		String xml = config.getInitParameter("contextConfigLocation");
			 	}
			 	public void service(HttpsServletRequest request,HttpServletResponse response)
			 	{
			 		//XML 설정파일이 없는경우 => default XML을 읽어온다
			 		<servlet-name>dispatcher</servlet-name>
			 		dispatcher-servlet.xml
			 	}
		   }
		   
		   
			DispatcherServlet
					| = HandleMapping : 메소드 찾기 => @Controller / @RestController
					| = ViewResolver : JSP를 찾아서 request전송
					| =	WebApplicationContext : 클래스 관리자
						
	 -->
	<servlet>
		<servlet-name>dispatcher</servlet-name>
		<servlet-class>org.springframework.web.servlet.DispatcherServlet</servlet-class>
		<init-param>
			<param-name>contextConfigLocation</param-name>
			<param-value>
				/WEB-INF/config/application-*.xml
				/WEB-INF/datasource/application-*.xml
			</param-value>
		</init-param>
	</servlet>
		
	<servlet-mapping>
		<servlet-name>dispatcher</servlet-name> <!-- 위  servlet-name과 일치해야한다-->
		<url-pattern>*.do</url-pattern>
	</servlet-mapping>
	<!-- 
		한글 변환
		에러 등록 : 코드번호마다 404,500 //
		보안 설정 
	 -->
	 
	 <filter>
	     <filter-name>encodingFilter</filter-name>
	     <filter-class>
	         org.springframework.web.filter.CharacterEncodingFilter
	     </filter-class>
	     <init-param>
	         <param-name>encoding</param-name>
	         <param-value>UTF-8</param-value>
	     </init-param>
	 </filter>
	 <filter-mapping>
	     <filter-name>encodingFilter</filter-name>
	     <url-pattern>/*</url-pattern>
	 </filter-mapping>


</web-app>
